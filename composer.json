{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "CC-BY-NC-SA-4.0",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-sodium": "*",
        "frankslin/opencc-pinyin": "^1.0",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^3.5",
        "jeremy379/laravel-openid-connect": "^3.3.0",
        "laracasts/flash": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/mcp": "^1.1.2",
        "laravel/passport": "^13.10.0",
        "laravel/sanctum": "^4.0",
        "laravel/serializable-closure": "^2.1",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.5",
        "nesbot/carbon": "^3.0",
        "phpmyadmin/sql-parser": "^6.0",
        "promphp/prometheus_client_php": "^2.14"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.0 || ^3.0",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php",
            "database/migrations/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "./vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/passport"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
