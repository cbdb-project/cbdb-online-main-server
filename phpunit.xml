<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <testsuites>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_KEY" value="base64:2RrmCTmv0x/wGC3bVP+p3I7RBx3JBaApKPLOkTqQGhI="/>
    <env name="DB_CONNECTION" value="sqlite"/>
    <env name="DB_DATABASE" value=":memory:"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SKIP_CSRF_TOKEN" value="true"/>
    <!-- 測試永遠不讀 `php artisan config:cache`／`route:cache` 留下的快取檔。
         有快取時，`.env`／本檔的環境變數整個失效（`CACHE_DRIVER=array` 也不生效）：測試會用機器上
         那份舊的 local／prod 設定跑——限流計數落到磁碟 file 快取、在測試之間甚至兩次執行之間殘留
         （症狀：FailedAuthenticationThrottleTest 第一個過、其餘全回 429），路由則可能缺少新加的路由。
         CI 沒有快取檔所以看不出來，是開發機專屬的假紅。
         這兩個變數指向**刻意不存在**的檔案，Laravel 就視為「沒有快取」。
         ⚠️ 限制（已實測）：PHPUnit 的 force 只更新 $_ENV 與 putenv，不更新 $_SERVER，而 Laravel 的 env() 先讀
         $_SERVER——所以宿主 shell **自己 export** 的同名變數（APP_ENV／CACHE_DRIVER／SESSION_DRIVER／本兩項）
         仍會勝出，phpunit.xml 擋不住。這種情況由守護測試顯式報錯並說明原因，不靠加 force。
         守護測試：tests/Unit/TestEnvironmentIsolationTest.php -->
    <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.phpunit-absent.php" force="true"/>
    <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.phpunit-absent.php" force="true"/>
    <env name="LOG_CHANNEL" value="errorlog"/>
    <!-- LLM 主端點固定為 chat/completions：端點以 /responses 結尾時會改走 Responses API 並轉換請求/回應格式，
         開發者本機 .env 若已指向 /responses（例如 HUIT），測試裡偽造的 chat 形狀回應就會對不上。
         要測 /responses 的測試請在案例內自己 config(['services.gemini.api_endpoint' => ...])。
         同理 key 與備援（_1）一律固定為空：備援 key 只要非空就會啟用備援，開發者本機 .env 有填時
         測試會多出備援重試或打向沒被 fake 的端點；CI 的 .env 沒有這些變量，固定為空才與 CI 行為一致。 -->
    <env name="GEMINI_API_ENDPOINT" value="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions" force="true"/>
    <env name="GEMINI_MODEL" value="gemini-3-flash-preview" force="true"/>
    <env name="GEMINI_API_KEY" value="" force="true"/>
    <env name="GEMINI_API_KEY_1" value="" force="true"/>
    <env name="GEMINI_API_ENDPOINT_1" value="" force="true"/>
    <env name="GEMINI_MODEL_1" value="" force="true"/>
    <env name="PROMETHEUS_ENABLED" value="false"/>
    <env name="PROMETHEUS_STORAGE_ADAPTER" value="memory"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
